{
  "expo": {
    "name": "HealthyPaw",
    "slug": "healthypaw",
    "scheme": "healthypaw",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "../../assets/brand/png/ios/icon-1024.png",
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      ["@react-native-google-signin/google-signin", { "iosUrlScheme": "com.googleusercontent.apps.550718186991-tjef8h72vabfsq5ci6vvnkjqd7bggki0" }],
      ["expo-notifications", { "color": "#FF8A4C" }]
    ],
    "ios": {
      "bundleIdentifier": "app.healthypaw",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "associatedDomains": ["applinks:healthypaw.app"],
      "icon": "../../assets/brand/ios/AppIcon.icon"
    },
    "android": {
      "package": "app.healthypaw",
      "adaptiveIcon": {
        "foregroundImage": "../../assets/brand/png/android/adaptive-foreground-1024.png",
        "monochromeImage": "../../assets/brand/png/android/adaptive-monochrome-1024.png",
        "backgroundColor": "#FF8A4C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "healthypaw.app", "pathPrefix": "/i/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": { "favicon": "../../assets/brand/png/web/favicon-48.png" },
    "extra": { "eas": {} }
  }
}
